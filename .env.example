# LLM & Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest
EMBEDDING_MODEL=nomic-embed-text:latest
LLM_TEMPERATURE=0.2

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents_collection

# Database (PostgreSQL / SQLite for local testing)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multiagent

# Security & JWT
JWT_SECRET=supersecretjwtkey_change_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# RAG & Agent Settings
TOP_K=10
RERANK_TOP_K=5
MAX_RETRIES=2
RETRIEVAL_CONFIDENCE_THRESHOLD=0.65

# App Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
